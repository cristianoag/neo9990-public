(text "1 - FULL MSX MEMORY + IO BUS" (at 25 14 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid d769c2ea-17a0-5953-990a-3726782ac9fc))
(text "2 - 16-BIT PARALLEL Pi HOST / UART" (at 120 14 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid f40738d7-73a2-528b-833f-1050de76a5e4))
(text "3 - EPM7160S: VCCINT=5 V / VCCIO=Pi 3.3 V" (at 235 14 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid e367a0a5-7219-5157-847a-ef6dc522ae4f))
(text "4 - 3.3 V JTAG / NO BUFFER REQUIRED" (at 365 14 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 662e7aaf-3ba4-5542-846e-630d6be7bbe6))
(text "5 - SLOT POWER: 2 A HOST REQUIRED; NO USB-C POWER" (at 25 209 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid e8fe3784-5bf6-5aeb-b283-68d7531b6618))
(text "6 - DECOUPLING / FAIL-SAFE PULLS / TEST POINTS" (at 205 209 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid d2e72807-b350-50d9-af2e-febef2001bdc))
(text "BOOT J5 installed: ROM pages 1/2 wait until Pi READY. Removed: no ROM startup stall." (at 25 355 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 3b2a5411-bbb8-5c99-b63c-9972b8fcd26e))
(text "JTAG J4 pin 4 is Pi-derived 3.3 V target Vref, NOT an external supply. Both CPLD rails must be up." (at 25 360 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 7788b917-f83f-5b4d-add1-149e98c088e5))
(text "PI0-15 = HOST_D0-15. Registers: STATUS, ADDRESS, REPLY/TICKET (D4), CONFIG." (at 25 365 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid bb155836-97cd-55b2-8fbd-fe6aa86d8c8d))
(text "All Pi-bound signals originate at CPLD 3.3 V I/O; raw 5 V MSX RESET/CLOCK never connect to Pi." (at 25 370 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 59d77629-5bff-5ec4-b48a-315914681989))
(text "Manufacturing hold: vendor fit/timing not run; EPM7160S requires legacy Quartus II 13.0 SP1." (at 25 375 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid b21ae141-9e18-54b2-8484-cc96d9060ed8))
(text "U5 limits Orange Pi load nominally to 1.51 A (1.41-1.63 A with 16.9k 1%); boot/load testing required." (at 25 380 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid e794a906-3fe2-5f6a-8a68-5a63623dd475))
(text "No hot insertion; no USB-C/USB VBUS source while installed. Common ground is mandatory." (at 25 385 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 40514704-896d-547e-a554-4a8ea8625091))
(text "V9990: 60-6F. OPL4: C4-C7 and 7E-7F. Enable only firmware-backed device profiles." (at 25 390 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 9bd62214-23a0-545e-961f-813d285b32a2))
(text "OPL4/HDMI audio requires future H618 firmware; no external DAC, SRAM or sample ROM fitted." (at 25 395 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid 22169de1-05bd-5ae5-9eec-572d4abbe280))
