  (text "NEO9990 - V9990 cartridge with Waveshare Core2350B (RP2350B)" (exclude_from_sim no) (at 20.32 15.24 0) (effects (font (size 3 3)) (justify left bottom)) (uuid "2397e374-ab8d-4a55-b037-2117a9e695e7"))
  (text "Core2350B wired directly to the MSX slot: no voltage translation (RP2350 GPIOs are 5 V tolerant at IOVDD = 3.3 V)" (exclude_from_sim no) (at 20.32 22.86 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "2bf5395f-24a3-4516-9747-15b6e8d98343"))
  (text "MSX slot (EDG1): only what a V9990 needs - A0-A7, D0-D7, /IORQ, /M1, /RD, /WR, /RESET, /INT, /WAIT, /BUSDIR" (exclude_from_sim no) (at 50.8 30.48 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "843b0747-6465-4deb-86f3-c2d48dc6a0c0"))
  (text "/INT, /WAIT and /BUSDIR are driven low only; release them by switching the GPIO to input (open-collector style)" (exclude_from_sim no) (at 50.8 35.56 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "1589c5b5-454f-4cb6-9f7f-accf7cd11826"))
  (text "PIO bus window = GPIO0-GPIO31 (GPIOBASE 0): GP0-3 = A0-A3, GP4-11 = D0-D7 (in pins,12 / out pins,8), HSTX owns GP12-GP19," (exclude_from_sim no) (at 50.8 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "eeef2f83-3baf-4393-a55f-9028955d7382"))
  (text "GP20-25 = A4-A7,/M1,/IORQ (port decode), GP26/27 = /RD,/WR, GP28-30 = /INT,/WAIT,/BUSDIR, GP31 = /RESET. GP47 = PSRAM CS." (exclude_from_sim no) (at 50.8 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "e8bf7bed-0c5a-4382-bccb-4455acaa3fde"))
  (text "Power: MSX +5V -> D1 -> module VBUS, USB-C and HDMI +5V. D1 keeps USB power out of the MSX." (exclude_from_sim no) (at 20.32 236.22 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "a0d8e8ee-25ec-475c-9810-3b9ae23b6266"))
  (text "R1/R2: pull-ups to +5V on /WAIT and /BUSDIR (as PicoVerse 2350). /RESET goes to GP31; close JP1 to also reset the module (RUN)." (exclude_from_sim no) (at 20.32 241.3 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "ab577106-fe03-434a-9d01-4a54c6595411"))
  (text "USB-C (same wiring as PicoVerse 2350): D+/D- to the module USB pins, 5.1K CC pull-downs, SW1 = BOOTSEL" (exclude_from_sim no) (at 266.7 30.48 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "8fe0415e-218a-4cff-b373-3ae3297572b8"))
  (text "HDMI/DVI via HSTX GP12-GP19: 270R series resistors, 5 V from the +5V rail, DDC/CEC/HPD not connected" (exclude_from_sim no) (at 266.7 147.32 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "36ee2ba5-a23b-479a-8145-370fabf19c06"))
  (text "Unused GPIOs: GP32-GP38, GP40-GP46. GP39 = module LED (470R), GP47 = module PSRAM chip select." (exclude_from_sim no) (at 20.32 266.7 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "e7c91f78-9336-4c1a-8eaa-2f50654226f1"))
  (text "V9990 firmware: the PIO decode value is 010110b (ports 60h-6Fh)." (exclude_from_sim no) (at 20.32 271.78 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "318b24f1-e840-48f6-a0ee-e573d7a5eb5e"))
  (sheet_instances (path "/" (page "1")))
)
